#include <stdio.h>
#include <stdlib.h>

#define MAX_VERTICES 105
#define MAX_EDGES 10005
#define INF 9999999

struct Edge {
    int src, dest, weight;
};

// Global variables for graph representation
int V, E;
struct Edge edges[MAX_EDGES];
int dist[MAX_VERTICES];
int parent[MAX_VERTICES];

// Function to print the path recursively from source to current node
void printPath(int current, int source) {
    if (current == source) {
        printf("%d", source);
        return;
    }
    printPath(parent[current], source);
    printf("->%d", current);
}

void bellmanFord(int source) {
    // 1. Initialize distances and parents
    for (int i = 1; i <= V; i++) {
        dist[i] = INF;
        parent[i] = -1;
    }
    dist[source] = 0;

    // 2. Relax all edges V - 1 times
    for (int i = 1; i <= V - 1; i++) {
        for (int j = 0; j < E; j++) {
            int u = edges[j].src;
            int v = edges[j].dest;
            int w = edges[j].weight;
            
            if (dist[u] != INF && dist[u] + w < dist[v]) {
                dist[v] = dist[u] + w;
                parent[v] = u;
            }
        }
    }

    // 3. Check for negative-weight cycles
    for (int j = 0; j < E; j++) {
        int u = edges[j].src;
        int v = edges[j].dest;
        int w = edges[j].weight;
        
        if (dist[u] != INF && dist[u] + w < dist[v]) {
            printf("Negative cycle detected\n");
            return;
        }
    }

    // 4. Print results matching the test case formatting: vertex dist path
    for (int i = 1; i <= V; i++) {
        if (i == source) continue;

        if (dist[i] == INF) {
            printf("%d INF None\n", i);
        } else {
            printf("%d %d ", i, dist[i]);
            printPath(i, source);
            printf("\n");
        }
    }
}

int main() {
    if (scanf("%d", &V) != 1) return 0;
    if (scanf("%d", &E) != 1) return 0;

    for (int i = 0; i < E; i++) {
        scanf("%d %d %d", &edges[i].src, &edges[i].dest, &edges[i].weight);
    }

    int source;
    scanf("%d", &source);

    bellmanFord(source);

    return 0;
}

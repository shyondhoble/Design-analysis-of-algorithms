#include <stdio.h>
#include <stdlib.h>

int main() {
    int r1, c1;
    // Read dimensions of matrix A
    if (scanf("%d %d", &r1, &c1) != 2) return 0;

    // Read Matrix A
    int A[r1][c1];
    for (int i = 0; i < r1; i++) {
        for (int j = 0; j < c1; j++) {
            if (scanf("%d", &A[i][j]) != 1) return 0;
        }
    }

    int r2, c2;
    // Read dimensions of matrix B
    if (scanf("%d %d", &r2, &c2) != 2) return 0;

    // Structural constraint check
    if (c1 != r2) {
        printf("Invalid input\n");
        return 0;
    }

    // Read elements of matrix B only if dimension validation passes
    int B[r2][c2];
    for (int i = 0; i < r2; i++) {
        for (int j = 0; j < c2; j++) {
            if (scanf("%d", &B[i][j]) != 1) return 0;
        }
    }

    // Initialize product matrix with zeros
    int C[r1][c2];
    for (int i = 0; i < r1; i++) {
        for (int j = 0; j < c2; j++) {
            C[i][j] = 0;
        }
    }

    // Matrix multiplication logic
    for (int i = 0; i < r1; i++) {
        for (int j = 0; j < c2; j++) {
            for (int k = 0; k < c1; k++) {
                C[i][j] += A[i][k] * B[k][j];
            }
        }
    }

    // Updated output formatting to match platform requirements
    for (int i = 0; i < r1; i++) {
        for (int j = 0; j < c2; j++) {
            // Print every number followed by a space (e.g., "58 ")
            printf("%d ", C[i][j]); 
        }
        printf("\n");
    }

    return 0;
}


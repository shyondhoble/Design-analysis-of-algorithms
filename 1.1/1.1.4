#include <stdio.h>
#include <stdlib.h>
#include <limits.h>



void kruskalMST(int **cost, int V) {

	// Write your code here...
	int *parent = (int *)malloc(V * sizeof(int));
    for (int i = 0; i < V; i++) {
        parent[i] = i;
    }

    int minimumCost = 0;
    int edgeIndex = 0;  // Tracks the printed index (Edge 0, Edge 1...)
    int edgesInMST = 0;

    // Kruskal's algorithm by repeatedly finding the absolute minimum edge
    while (edgesInMST < V - 1) {
        int minWeight = 9999;
        int u = -1, v = -1;

        // Find the overall minimum weight edge remaining in the graph
        for (int i = 0; i < V; i++) {
            for (int j = 0; j < V; j++) {
                // Skip self-loops or infinity values
                if (cost[i][j] != 9999 && cost[i][j] != 0 && cost[i][j] < minWeight) {
                    // Check if including this edge forms a cycle
                    // Inline 'find' operation with path compression tracking
                    int root_i = i;
                    while (root_i != parent[root_i]) {
                        root_i = parent[root_i];
                    }
                    
                    int root_j = j;
                    while (root_j != parent[root_j]) {
                        root_j = parent[root_j];
                    }

                    // If roots are different, it's a safe candidate edge
                    if (root_i != root_j) {
                        minWeight = cost[i][j];
                        u = i;
                        v = j;
                    }
                }
            }
        }

        // If no more valid edges can be found, break out to prevent infinite loop
        if (u == -1 || v == -1) {
            break;
        }

        // Find roots one more time to perform the inline Union operation
        int root_u = u;
        while (root_u != parent[root_u]) {
            root_u = parent[root_u];
        }
        int root_v = v;
        while (root_v != parent[root_v]) {
            root_v = parent[root_v];
        }

        // Union: Connect the components together
        parent[root_u] = root_v;

        // Print using the precise required format
        printf("Edge %d:(%d, %d) cost:%d\n", edgeIndex++, u, v, minWeight);
        minimumCost += minWeight;
        edgesInMST++;

        // Mark this edge as visited by setting it to infinity (9999) 
        // in both directions so it isn't picked again
        cost[u][v] = 9999;
        cost[v][u] = 9999;
    }

    // Final total output
    printf("Minimum cost= %d\n", minimumCost);

    // Free the dynamically allocated parent array
    free(parent);
}




int main() {
    int V;
    printf("No of vertices: ");
    scanf("%d", &V);

    int **cost = (int **)malloc(V * sizeof(int *));
    for (int i = 0; i < V; i++)
        cost[i] = (int *)malloc(V * sizeof(int));

    printf("Adjacency matrix:\n");
    for (int i = 0; i < V; i++)
        for (int j = 0; j < V; j++)
            scanf("%d", &cost[i][j]);

    kruskalMST(cost, V);

    for (int i = 0; i < V; i++)
        free(cost[i]);
    free(cost);

    return 0;
}
